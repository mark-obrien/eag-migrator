# ---------------------------------------------------------------------------
# EAG v2 -> v3 migrator configuration
#
#   cp .env.example .env     and fill in the real values.
#   .env is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Source: EAG v2 --------------------------------------------------------
# SQLAlchemy URL. Pick the line matching whatever v2 actually runs on.
#
#   MySQL / MariaDB   mysql+pymysql://user:pass@host:3306/dbname
#   PostgreSQL        postgresql+psycopg://user:pass@host:5432/dbname
#   SQL Server        mssql+pymssql://user:pass@host:1433/dbname
#   SQLite (a file)   sqlite:////data/v2.db
#
# The defaults below point at the local containers from docker-compose.
V2_DATABASE_URL=mysql+pymysql://eag:eag@v2-mysql:3306/eag_v2

# Optional: restrict discovery to one schema (Postgres/MSSQL). Blank = default.
V2_SCHEMA=

# --- Target: EAG v3 --------------------------------------------------------
V3_DATABASE_URL=postgresql+psycopg://eag:eag@v3-postgres:5432/eag_v3
V3_SCHEMA=

# --- Optional: write through the v3 HTTP API instead of straight to its DB --
# Leave V3_API_BASE_URL blank to use the SQL sink (the default).
V3_API_BASE_URL=
V3_API_TOKEN=
V3_API_TIMEOUT=30

# --- Multi-tenant platforms ------------------------------------------------
# v2 is one app per shop (<shop>.everythingautoglass.com), so both config files
# expand ${VAR} and ${VAR:-default}. One config then serves every shop, and no
# customer's hostname ends up in a committed file:
#
#   config/harvest.yaml:  base_url: https://${TENANT}.everythingautoglass.com
#
# An unset variable is an error, not an empty string.
TENANT=

# --- Web source: no database and no API access to v2 -----------------------
# If you cannot reach v2's database, read the live app instead:
#
#   eagm login   https://the-v2-app.example      # store a session
#   eagm recon   https://the-v2-app.example      # what is it? behind a login?
#   eagm capture https://the-v2-app.example      # what API does it call?
#   eagm harvest                                 # -> state/staging.sqlite
#
# Then point V2_DATABASE_URL at the staging file and carry on as normal:
#   V2_DATABASE_URL=sqlite:////app/state/staging.sqlite

# How the migrator authenticates to v2. Preferred: sign in with your own
# browser, copy the Cookie request header from devtools, and put it here —
# no password is ever handled by this tool. Passing it via the environment
# also keeps it out of `ps` and your shell history.
EAGM_COOKIE=
# ...or a bearer token, if the app issues them. "Bearer " is added if missing.
EAGM_AUTH_TOKEN=
# Only for unattended `eagm login --form`, which drives the real login page.
# Prefer EAGM_COOKIE and leave these blank.
EAGM_USERNAME=
EAGM_PASSWORD=

# `eagm capture` and `eagm login --form` need Chromium. It is in the image by
# default; `make build-slim` leaves it out for database-only migrations, and
# `make build-browser` adds it back. If you already have a Chrome/Chromium
# elsewhere, point at it instead:
# EAGM_CHROMIUM_PATH=

# Optional. `eagm draft-html --assist` asks a model to read a list screen's
# structure when the built-in heuristics do badly on it. One call per screen,
# never per record — bulk extraction stays deterministic. Every text value and
# data-carrying attribute is stripped before the request is built, so no
# customer data leaves this machine. Leave blank and nothing calls out.
ANTHROPIC_API_KEY=
# EAGM_ASSIST_MODEL=claude-sonnet-5

# --- Writing to v3 through its HTTP API instead of its database -------------
# Set a base URL to use the API sink. v3's own validation then runs on every
# record, so the target cannot end up in a state v3 itself would reject.
# V3_API_BASE_URL=https://shop.eagsoftware.com
# V3_API_TOKEN=
# ...or, for a target that issues no token and authenticates with a session
# cookie, paste the Cookie header from a signed-in browser:
# V3_API_COOKIE=

# --- Dashboard --------------------------------------------------------------
# `make dashboard` serves it on 127.0.0.1. Compose publishes the port on the
# loopback interface only, because this UI holds a live v2 session and can
# write to v3.
#
# 8080 is the most contended port on a dev machine, so the default is 19080.
# Change it here if that clashes too; docker compose and the CLI both read it,
# and `eagm dashboard` reports a clash rather than dying in the server.
EAGM_DASHBOARD_PORT=19080

# Set a token if you expose the dashboard anywhere but localhost — every page
# and action then requires ?token=…
EAGM_DASHBOARD_TOKEN=

# Host port for the optional adminer database browser (--profile tools).
ADMINER_PORT=18080

# --- Run behaviour ---------------------------------------------------------
BATCH_SIZE=500
# record = log the failure and keep going;  abort = stop the whole run
ON_ERROR=record
# Redact values matching these column-name patterns in profiles and reports.
REDACT_PATTERNS=password,passwd,pwd,hash,salt,token,secret,ssn,social,card,cvv,api_key,auth
