# Secrets — never commit real connection strings
.env
*.env
!.env.example

# Discovery output & run artifacts (may contain customer data)
/profiles/*.json
/profiles/*.md
/reports/*
/state/*
# Harvested site content and the HTTP cache — the client's data, not ours.
/state/staging.sqlite*
/state/webcache/
# Live credentials to the v2 app and the v3 API. Never commit.
/state/session.json
/state/v3_session.json
!**/.gitkeep

# Database dumps — these are production data, keep them out of git
/db/v2-seed/*
/db/v3-seed/*
!/db/v2-seed/.gitkeep
!/db/v3-seed/.gitkeep

# Generated mapping drafts (review, rename, then commit deliberately)
/config/mapping.draft.yaml
/config/harvest.draft.yaml

# The live configs are promoted from one of the tracked configs at run time,
# and the previous one is kept alongside as .bak. Runtime state, not source —
# committing them would pin whichever shop was migrated last.
/config/harvest.yaml
/config/harvest.yaml.bak
/config/mapping.yaml
/config/mapping.yaml.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.whl
*.tar.gz
